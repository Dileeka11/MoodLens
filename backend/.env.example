# Copy this file to backend/.env and adjust the values.

# --- MySQL ---
# XAMPP default: user=root, empty password, port 3306
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=moodlens

# --- JWT ---
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Artifact paths ---
# Directory holding ncf_model.pth, movie2idx.pkl, user2idx.pkl, movies.csv.
# Default is the project root (one level above backend/).
ARTIFACT_DIR=..

# --- Models ---
SBERT_MODEL=all-MiniLM-L6-v2
NCF_EMBEDDING_SIZE=50
NCF_WEIGHT=0.7
SBERT_WEIGHT=0.3
TOP_K=5

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- TMDB (optional) ---
# Free key: https://www.themoviedb.org/settings/api
# Only used by app.scripts.backfill_tmdb to fill posters/synopses/runtimes.
TMDB_API_KEY=
TMDB_IMAGE_SIZE=w500

# --- SMTP (password reset) ---
# Leave SMTP_HOST empty to develop without a mail server: reset emails are
# logged and saved to backend/cache/sent_emails/ instead of being sent.
#
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use that 16-character value
# as SMTP_PASSWORD (your normal Gmail password will NOT work).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Base URL of the frontend, used to build the reset link in the email.
APP_BASE_URL=http://localhost:5180
RESET_TOKEN_MINUTES=60
